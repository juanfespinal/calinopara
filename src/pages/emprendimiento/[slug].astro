---
import Base from "../../layouts/Base.astro";
import DishModal from "../../components/DishModal.astro";
import InstagramFeed from "../../components/InstagramFeed.astro";
import InstagramReel from "../../components/InstagramReel.astro";
import PlaceVideo from "../../components/PlaceVideo.astro";
import { categories, formatCop, getPlace, places, statusLabel } from "../../data/emprendimientos";

export function getStaticPaths() {
  return places.map((place) => ({ params: { slug: place.slug } }));
}

const { slug } = Astro.params;
const place = getPlace(slug!);
if (!place) throw new Error("Negocio no encontrado");

const category = categories.find((c) => c.id === place.category);
const hasPhysicalLocation = place.hasPhysicalLocation !== false;
const mapsQuery = encodeURIComponent(
  place.lat != null && place.lng != null ? `${place.lat},${place.lng}` : `${place.address}, Cali`,
);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
const ig = place.instagram ? `https://www.instagram.com/${place.instagram}/` : null;
const wa = place.whatsapp ? `https://wa.me/${place.whatsapp}` : null;
const tel = place.phone ? `tel:${place.phone}` : null;
const orderHref = place.orderUrl ?? wa ?? tel;
const orderNewTab = orderHref ? !orderHref.startsWith("tel:") : false;
const canOrder = Boolean(orderHref);
const logoSrc = place.logo ?? place.photo;
const menuHasPhotos = place.menu.some((item) => Boolean(item.photo));
---

<Base title={`${place.name} · Cali No Para`} description={`${place.tagline} en ${place.barrio}.`}>
  <article class="wrap detail-page">
    <a class="back" href="/">← Todos los negocios</a>

    <section class="story-block" data-story-first aria-labelledby="historia">
      <h2 id="historia">Conoce su historia</h2>
      {place.video ? (
        <PlaceVideo
          src={place.video}
          poster={place.photo}
          slug={place.slug}
          name={place.name}
          handle={place.instagram}
          post={place.instagramPost}
        />
      ) : place.instagramPost ? (
        <InstagramReel shortcode={place.instagramPost} name={place.name} />
      ) : place.instagram && ig ? (
        <div class="reel-hero">
          <img class="reel-hero-photo" src={place.photo} alt={place.photoAlt} width="1200" height="1600" />
          <div class="reel-hero-top">
            <a class="reel-hero-user" href={ig} target="_blank" rel="noopener noreferrer">
              <span class="reel-hero-avatar">{place.name.slice(0, 1)}</span>
              <span class="reel-hero-handle">@{place.instagram}</span>
            </a>
          </div>
          <div class="reel-hero-caption">
            <p>{place.tagline}</p>
          </div>
        </div>
      ) : (
        <figure class="hero-photo">
          <img src={place.photo} alt={place.photoAlt} width="1200" height="900" />
        </figure>
      )}
    </section>

    <header class="detail-hero">
      <img class="place-logo" src={logoSrc} alt="" width="72" height="72" />
      <h1>{place.name}</h1>
      <p class="brand-kicker">{category?.label} · {place.barrio}</p>
      <p>{place.tagline}</p>
      <p class="detail-meta">
        <span class:list={["badge", place.status]}>{statusLabel[place.status]}</span>
        {ig && (
          <a class="ig-inline" href={ig} target="_blank" rel="noopener noreferrer" data-analytics-event="view_instagram" data-analytics-business-slug={place.slug}>
            @{place.instagram}
          </a>
        )}
      </p>
    </header>

    <section class="menu-block" aria-labelledby="carta">
      <h2 id="carta">La carta</h2>
      <ul class:list={["menu", menuHasPhotos && "menu-grid"]}>
        {place.menu.map((item, index) => (
          <li>
            <button type="button" class="menu-card" data-dish data-analytics-event="view_menu_item" data-analytics-business-slug={place.slug} data-analytics-item-name={item.name} aria-haspopup="dialog">
              {item.photo ? (
                <img
                  class="menu-thumb"
                  src={item.photo}
                  alt=""
                  width="600"
                  height="600"
                  loading={index < 4 ? "eager" : "lazy"}
                />
              ) : (
                <span class="menu-swatch" role="img" aria-label="Sin foto disponible">
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
                    <circle cx="9" cy="10" r="1.6" fill="currentColor"/>
                    <path d="M3 16l5-4 4 3 3-2 6 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                  </svg>
                </span>
              )}
              <div class="menu-copy">
                <strong>{item.name}</strong>
                <p>{item.desc}</p>
              </div>
              <span class="menu-price">{formatCop(item.price) ?? "Consulta"}</span>
            </button>
          </li>
        ))}
      </ul>
      {place.menuNote && <p class="menu-note">{place.menuNote}</p>}
      {place.menuUrl && (
        <p class="menu-source">
          <a href={place.menuUrl} target="_blank" rel="noopener noreferrer">Ver carta completa</a>
        </p>
      )}
    </section>

    {place.status !== "cerrado" && (canOrder || hasPhysicalLocation) && (
      <div class="order-bar" aria-label="Acciones del negocio">
        {canOrder && (
          <a
            class="btn btn-primary"
            href={orderHref}
            data-analytics-event="support_click"
            data-analytics-business-slug={place.slug}
            data-analytics-channel={orderHref.startsWith("https://wa.me/") ? "whatsapp" : orderHref.startsWith("tel:") ? "phone" : "order_url"}
            target={orderNewTab ? "_blank" : undefined}
            rel={orderNewTab ? "noopener noreferrer" : undefined}
          >
            <svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 5.5A3.5 3.5 0 0 1 8.5 2h7A3.5 3.5 0 0 1 19 5.5v5a3.5 3.5 0 0 1-3.5 3.5h-3l-4.5 4v-4.15A3.5 3.5 0 0 1 5 10.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
              <path d="M9 7.5h6M9 10.5h3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            {place.orderLabel ?? "Pedir ahora"}
          </a>
        )}
        {hasPhysicalLocation && (
          <a class="btn btn-ghost" href={mapsUrl} data-analytics-event="get_directions" data-analytics-business-slug={place.slug}>
            <svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 21s6-5.4 6-11a6 6 0 1 0-12 0c0 5.6 6 11 6 11Z" fill="none" stroke="currentColor" stroke-width="1.8" />
              <circle cx="12" cy="10" r="2" fill="none" stroke="currentColor" stroke-width="1.8" />
            </svg>
            Cómo llegar
          </a>
        )}
      </div>
    )}

    {hasPhysicalLocation && (
      <section class="panel">
        <h2>Dónde</h2>
        <address>
          {place.address}
          {place.coordsApproximate && <p>Ubicación de barrio o centro comercial.</p>}
        </address>
      </section>
    )}

    {place.instagram && <InstagramFeed handle={place.instagram} name={place.name} />}
  </article>
  <DishModal />
</Base>

<script>
  import { initDishModal } from "../../scripts/dish-modal";
  initDishModal();
</script>
