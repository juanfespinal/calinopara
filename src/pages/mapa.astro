---
import Base from "../layouts/Base.astro";
import { categories, places } from "../data/emprendimientos";

const categoryLabel = new Map(categories.map((category) => [category.id, category.label]));
const placesWithCoordinates = places.filter((place) => place.lat != null && place.lng != null);
---

<Base title="Mapa · Cali No Para" bodyClass="map-page">
  <section class="map-view" data-directory data-map-page="true" data-view="mapa">
    <div class="map-view-controls">
      <label class="visually-hidden" for="buscar-mapa">Buscar negocio en el mapa</label>
      <input
        id="buscar-mapa"
        class="search"
        type="search"
        placeholder="Busca por nombre o barrio"
        data-search
        autocomplete="off"
      />
      <div class="category-filters" role="group" aria-label="Filtrar mapa por categoría">
        <button type="button" data-category-filter="todos" aria-pressed="true">Todos</button>
        {categories.map((category) => (
          <button type="button" data-category-filter={category.id} aria-pressed="false">{category.label}</button>
        ))}
      </div>
    </div>

    <details class="map-directory" data-map-directory>
      <summary>
        <span data-count>{places.length} negocios</span>
        <span aria-hidden="true">·</span>
        <span data-map-coordinate-count>{placesWithCoordinates.length} en el mapa</span>
      </summary>
      <div class="map-directory-panel">
        <p class="map-directory-note">
          Los negocios sin una dirección pública precisa siguen disponibles aquí, pero no reciben un pin aproximado.
        </p>
        <nav class="map-directory-list" aria-label="Resultados del mapa">
          {places.map((place) => {
            const hasCoordinates = place.lat != null && place.lng != null;
            const locationLabel = hasCoordinates
              ? "Ubicación en el mapa"
              : place.hasPhysicalLocation === false
                ? "Domicilios o ubicación no publicada"
                : "Consulta la dirección en su ficha";

            return (
              <a
                href={`/emprendimiento/${place.slug}`}
                data-slug={place.slug}
                data-category={place.category}
                data-has-coordinates={String(hasCoordinates)}
              >
                <img src={place.logo ?? place.photo} alt="" width="44" height="44" loading="lazy" />
                <span>
                  <strong>{place.name}</strong>
                  <small>{categoryLabel.get(place.category)} · {place.barrio}</small>
                  <small class:list={["map-location-label", { "is-mapped": hasCoordinates }]}>{locationLabel}</small>
                </span>
              </a>
            );
          })}
        </nav>
        <p class="empty map-directory-empty" data-empty hidden>No hay negocios con esa búsqueda.</p>
      </div>
    </details>

    <div class="map-pane map-pane-full" data-map-pane>
      <div class="map-frame map-solo" data-map aria-label="Mapa de Cali con los negocios"></div>
      <aside class="map-sheet" data-map-sheet hidden aria-label="Negocio seleccionado">
        <img data-sheet-photo src="" alt="" width="96" height="96" />
        <div class="map-sheet-copy">
          <h2 data-sheet-name></h2>
          <p data-sheet-meta></p>
          <p class="map-sheet-status" data-sheet-status aria-live="polite"></p>
        </div>
        <a class="btn btn-primary" data-sheet-link href="/">Ver detalle</a>
      </aside>
    </div>
  </section>
</Base>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>

<script>
  import { initDirectory } from "../scripts/directory";
  import { places } from "../data/emprendimientos";

  const root = document.querySelector<HTMLElement>("[data-directory]");
  if (root) initDirectory(root, places);
</script>
