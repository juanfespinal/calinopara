---
import Base from "../layouts/Base.astro";
import InitiativeDialog from "../components/InitiativeDialog.astro";
import ReelTile from "../components/ReelTile.astro";
import { initiative } from "../data/initiative.mjs";
import { categories, places } from "../data/emprendimientos";

const stories = places.filter((p) => p.instagram);
---

<Base title="Cali No Para · carta local">
  <section class="wrap hero">
    <p class="hero-kicker">{initiative.heroKicker}</p>
    <h1>{initiative.heroTitle}</h1>
    <p class="hero-lead">{initiative.heroText}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#directorio">Explorar negocios</a>
      <button class="btn btn-ghost" type="button" data-initiative-open>Conoce la iniciativa</button>
    </div>
  </section>

  <section class="wrap initiative-intro" aria-labelledby="initiative-title">
    <div>
      <p class="brand-kicker">{initiative.introKicker}</p>
      <h2 id="initiative-title">{initiative.introTitle}</h2>
      <p>{initiative.introText}</p>
    </div>
    <ul class="initiative-principles">
      {initiative.principles.map((principle) => <li>{principle}</li>)}
    </ul>
  </section>

  <section class="wrap" id="directorio" data-directory data-view="lista">
    {stories.length > 0 && (
      <nav class="story-rail" aria-label="Historias">
        {stories.map((place) => (
          <a class="story" href={`/emprendimiento/${place.slug}`}>
            <span class="story-ring">
              <img src={place.photo} alt="" width="54" height="54" />
            </span>
            <span class="story-name">{place.name.split(/\s+/)[0]}</span>
          </a>
        ))}
      </nav>
    )}

    <div class="toolbar">
      <div class="toolbar-row">
        <label class="visually-hidden" for="buscar">Buscar negocio</label>
        <input
          id="buscar"
          class="search"
          type="search"
          placeholder="Busca por nombre o barrio"
          data-search
          autocomplete="off"
        />
        <div class="view-toggle" role="group" aria-label="Tipo de vista">
          <button type="button" data-view="lista" aria-pressed="true">Lista</button>
          <button type="button" data-view="mapa" aria-pressed="false">Mapa</button>
        </div>
      </div>
      <div class="chips" role="toolbar" aria-label="Categorías">
        <button class="chip" type="button" data-chip="todos" aria-pressed="true">Todos</button>
        {categories.map((cat) => (
          <button class="chip" type="button" data-chip={cat.id} aria-pressed="false">
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <p class="meta-row">
      <span data-count>{places.length} negocios</span>
    </p>

    <div class="map-pane" data-map-pane hidden>
      <div class="map-frame map-solo" data-map aria-label="Mapa de Cali con los negocios"></div>
    </div>

    <div data-list-pane>
      <div class="list" data-list>
        {places.map((place) => <ReelTile place={place} />)}
      </div>
      <p class="empty" data-empty hidden>No hay negocios con ese filtro. Prueba otra categoría.</p>
    </div>
  </section>

  <section class="wrap invite" aria-labelledby="invite-title">
    <h2 id="invite-title">¿Tu negocio se vio afectado?</h2>
    <p>
      Cali No Para es este directorio. Si el sismo tocó tu local y no estás en la lista, cuenta tu caso. Lo revisamos a mano.
    </p>
    <a class="btn btn-primary" href="/sumate">Presentar mi negocio</a>
  </section>

  <InitiativeDialog />
</Base>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>

<script>
  import { initDirectory } from "../scripts/directory";
  import { initInitiativeDialog } from "../scripts/initiative-dialog";
  import { places } from "../data/emprendimientos";

  const root = document.querySelector<HTMLElement>("[data-directory]");
  if (root) initDirectory(root, places);
  initInitiativeDialog();
</script>
