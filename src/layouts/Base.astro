---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Cali No Para: negocios de la ciudad, con lo que venden y cómo pedir.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <img
            class="brand-logo"
            src="/brand/cali-no-para.png"
            alt="Cali No Para"
            width="401"
            height="420"
          />
        </a>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <a class="footer-brand" href="/">
          <img
            class="footer-logo"
            src="/brand/cali-no-para-cali-blanco.png"
            alt="Cali No Para"
            width="377"
            height="420"
          />
        </a>
        <p>
          <span class="footer-lead">Código abierto. </span>
          Si eres desarrollador y quieres aportar, el GitHub está abierto.
          {" "}
          <a href="https://github.com/juanfespinal/calinopara" target="_blank" rel="noopener noreferrer">
            Aporta en GitHub
          </a>.
        </p>
        <p>
          <span class="footer-lead">¿Tu negocio se vio afectado? </span>
          Cali No Para es este directorio. Si el tuyo no está,{" "}
          <a href="/sumate">presenta tu caso</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
