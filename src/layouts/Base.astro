---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Carta de emprendimientos caleños: postres, almuerzos, café y más. Pide local.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="brand-kicker">Cali · la carta</span>
          <span class="brand-name">La Vitrina</span>
        </a>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          Lista armada a partir del post de <a href="https://www.instagram.com/p/DcMetBJlMza/">@dilettopasticceria</a>, comentarios de vecinos y notas de prensa. No es un censo oficial. Confirma horarios antes de salir.
        </p>
        <p>
          Daños de vivienda: <a href="https://atencionsismo.cali.gov.co">atencionsismo.cali.gov.co</a>.
          Emergencias: 123.
        </p>
      </div>
    </footer>
  </body>
</html>
