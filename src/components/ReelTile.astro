---
import { statusLabel, type Place } from "../data/emprendimientos";

interface Props {
  place: Place;
}

const { place } = Astro.props;
const hasLocalVideo = Boolean(place.video);
---

<article
  class="reel-tile"
  data-slug={place.slug}
  data-category={place.category}
  data-has-video={hasLocalVideo ? "true" : undefined}
>
  <a
    class="reel-tile-link"
    href={`/emprendimiento/${place.slug}`}
    data-analytics-event="select_business"
    data-analytics-business-slug={place.slug}
    data-analytics-business-name={place.name}
  >
    {!hasLocalVideo && (
      <img
        class="reel-tile-photo"
        src={place.photo}
        alt={place.photoAlt}
        width="600"
        height="800"
        loading="lazy"
      />
    )}
    {place.instagramPost && !hasLocalVideo && (
      <span class="reel-tile-play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="11" height="11" aria-hidden="true">
          <polygon points="8,5 19,12 8,19" fill="currentColor" />
        </svg>
      </span>
    )}
    <span class:list={["badge", place.status]}>{statusLabel[place.status]}</span>
    <div class="reel-tile-scrim">
      <h2>{place.name}</h2>
      <p>{place.barrio}</p>
    </div>
  </a>
  {hasLocalVideo && (
    <>
      <video
        class="reel-tile-video"
        data-reel-video
        poster={place.videoPoster ?? `/video-posters/${place.slug}.jpg`}
        preload="none"
        muted
        playsinline
        controls
        tabindex="-1"
        aria-label={`Video de ${place.name}`}
      >
        <source src={place.video} type="video/mp4" />
      </video>
      <button
        class="reel-tile-play"
        type="button"
        data-reel-play
        aria-label={`Reproducir historia de ${place.name}`}
      >
        <svg viewBox="0 0 24 24" width="11" height="11" aria-hidden="true">
          <polygon points="8,5 19,12 8,19" fill="currentColor" />
        </svg>
      </button>
    </>
  )}
</article>
