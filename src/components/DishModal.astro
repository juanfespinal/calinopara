<dialog class="dish-modal" data-dish-modal aria-labelledby="dish-modal-title">
  <div class="dish-modal-panel" data-dish-panel>
    <img class="dish-modal-photo" data-dish-photo alt="" width="800" height="800" hidden />
    <div class="dish-modal-body">
      <h3 id="dish-modal-title" data-dish-title></h3>
      <p data-dish-desc></p>
      <p class="dish-modal-price" data-dish-price></p>
    </div>
    <button type="button" class="dish-modal-close" data-dish-close aria-label="Cerrar">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          d="M6 6l12 12M18 6L6 18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </div>
</dialog>
