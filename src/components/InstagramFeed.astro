---
interface Props {
  handle: string;
  name: string;
}

const { handle, name } = Astro.props;
const profile = `https://www.instagram.com/${handle}/`;
const embed = `https://www.instagram.com/${handle}/embed/`;
---

<section class="ig-block" aria-labelledby="ig-title">
  <div class="ig-head">
    <h2 id="ig-title">Instagram</h2>
    <a class="btn btn-ghost ig-profile" href={profile} target="_blank" rel="noopener noreferrer">
      Ver en Instagram
    </a>
  </div>
  <iframe
    class="ig-frame"
    src={embed}
    loading="lazy"
    allow="encrypted-media; clipboard-write"
    referrerpolicy="no-referrer-when-downgrade"
    title={`Publicaciones recientes de ${name} en Instagram`}
  ></iframe>
</section>
