---
import { instagramPostUrl } from "../data/emprendimientos";

interface Props {
  src: string;
  poster: string;
  slug: string;
  name: string;
  handle?: string;
  post?: string;
}

const { src, poster, slug, name, handle, post } = Astro.props;
const postUrl = post ? instagramPostUrl(post) : handle ? `https://www.instagram.com/${handle}/` : null;
---

<figure class="reel-player">
  <div class="reel-hero">
    <video
      class="reel-hero-photo"
      poster={poster}
      data-analytics-business-slug={slug}
      controls
      playsinline
      preload="none"
      controlslist="nodownload"
      aria-label={`Video de ${name}`}
    >
      <source src={src} type="video/mp4" />
    </video>
  </div>
  {postUrl && (
    <figcaption class="reel-credit">
      Video original de{" "}
      {handle ? `@${handle}` : name}
      {" · "}
      <a href={postUrl} target="_blank" rel="noopener noreferrer">Ver en Instagram</a>
    </figcaption>
  )}
</figure>

<script>
  import { trackEvent } from "../scripts/analytics";

  const videos = document.querySelectorAll(".reel-hero video[data-analytics-business-slug]");

  videos.forEach((video) => {
    const businessSlug = video.dataset.analyticsBusinessSlug ?? "negocio-local";
    let hasTrackedStart = false;

    video.addEventListener("ended", () => {
      trackEvent("video_complete", { business_slug: businessSlug, content_type: "business_story" });
    });
    video.addEventListener("play", () => {
      if (hasTrackedStart) return;
      hasTrackedStart = true;
      trackEvent("video_start", { business_slug: businessSlug, content_type: "business_story" });
    });
  });
</script>
