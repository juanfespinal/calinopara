---
import { instagramPostUrl } from "../data/emprendimientos";

interface Props {
  src: string;
  poster: string;
  name: string;
  handle?: string;
  post?: string;
}

const { src, poster, name, handle, post } = Astro.props;
const postUrl = post ? instagramPostUrl(post) : handle ? `https://www.instagram.com/${handle}/` : null;
---

<figure class="reel-player">
  <div class="reel-hero">
    <video
      class="reel-hero-photo"
      poster={poster}
      controls
      playsinline
      preload="none"
      controlslist="nodownload"
      aria-label={`Video de ${name}`}
    >
      <source src={src} type="video/mp4" />
    </video>
    <button
      type="button"
      class="reel-hero-play"
      data-video-toggle
      data-analytics-business-name={name}
      aria-label={`Reproducir video de ${name}`}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m9 6 9 6-9 6z" fill="currentColor" />
      </svg>
    </button>
  </div>
  {postUrl && (
    <figcaption class="reel-credit">
      Video original de{" "}
      {handle ? `@${handle}` : name}
      {" · "}
      <a href={postUrl} target="_blank" rel="noopener noreferrer">Ver en Instagram</a>
    </figcaption>
  )}
</figure>

<script>
  import { trackEvent } from "../scripts/analytics";

  const toggles = document.querySelectorAll("[data-video-toggle]");

  toggles.forEach((toggle) => {
    const video = toggle.closest(".reel-hero")?.querySelector("video");
    if (!video) return;
    const businessName = toggle.dataset.analyticsBusinessName ?? "Negocio local";
    let hasTrackedStart = false;

    const syncToggle = () => {
      toggle.hidden = !video.paused;
      toggle.setAttribute(
        "aria-label",
        video.paused ? "Reproducir video" : "Pausar video",
      );
    };

    toggle.addEventListener("click", async () => {
      try {
        if (video.paused) {
          await video.play();
        } else {
          video.pause();
        }
      } catch {
        syncToggle();
      }
    });

    video.addEventListener("play", syncToggle);
    video.addEventListener("pause", syncToggle);
    video.addEventListener("play", () => {
      if (hasTrackedStart) return;
      hasTrackedStart = true;
      trackEvent("video_start", { business_name: businessName, content_type: "business_story" });
    });
    video.addEventListener("ended", () => {
      syncToggle();
      trackEvent("video_complete", { business_name: businessName, content_type: "business_story" });
    });
    syncToggle();
  });
</script>
